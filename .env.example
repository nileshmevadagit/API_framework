# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Config files reference these as ${NAME}; the loader never accepts literal secrets.

# GitHub token for integration tests (raises the rate limit from 60 to 5,000 req/hour).
# Create at https://github.com/settings/tokens with no scopes (public data only).
GITHUB_TOKEN=

# Optional: corporate forward proxy
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1

# Local services from docker-compose.yml
HTTPBIN_URL=http://localhost:8080
REDIS_URL=redis://localhost:6379/0
