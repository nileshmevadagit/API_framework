{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "pytest: current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-x", "-vv"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "pytest: integration (needs docker compose up)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-m", "integration", "-vv"],
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Python: current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}
